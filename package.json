{
  "name": "codevault",
  "displayName": "CodeVault",
  "description": "Save, organize, copy and execute commands, code snippets, functions and notes — your personal developer vault.",
  "version": "1.0.0",
  "publisher": "rafa9-labs",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/rafa9-labs/codevault.git"
  },
  "homepage": "https://github.com/rafa9-labs/codevault#readme",
  "bugs": {
    "url": "https://github.com/rafa9-labs/codevault/issues"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other",
    "Snippets",
    "Programming Languages"
  ],
  "keywords": [
    "snippets",
    "commands",
    "code",
    "vault",
    "clipboard"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "codevault-container",
          "title": "CodeVault",
          "icon": "resources/icon.svg"
        }
      ]
    },
    "views": {
      "codevault-container": [
        {
          "id": "codevault-explorer",
          "name": "CodeVault",
          "icon": "resources/icon.svg",
          "type": "webview"
        }
      ]
    },
    "commands": [
      {
        "command": "codevault.add",
        "title": "CodeVault: Add Item",
        "icon": "$(add)"
      },
      {
        "command": "codevault.edit",
        "title": "CodeVault: Edit Item",
        "icon": "$(edit)"
      },
      {
        "command": "codevault.delete",
        "title": "CodeVault: Delete Item"
      },
      {
        "command": "codevault.copy",
        "title": "CodeVault: Copy Content",
        "icon": "$(copy)"
      },
      {
        "command": "codevault.execute",
        "title": "CodeVault: Execute Command",
        "icon": "$(play)"
      },
      {
        "command": "codevault.export",
        "title": "CodeVault: Export Data",
        "icon": "$(export)"
      },
      {
        "command": "codevault.import",
        "title": "CodeVault: Import Data",
        "icon": "$(import)"
      },
      {
        "command": "codevault.search",
        "title": "CodeVault: Search Items",
        "icon": "$(search)"
      },
      {
        "command": "codevault.refresh",
        "title": "CodeVault: Refresh",
        "icon": "$(refresh)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "codevault.add",
          "when": "view == codevault-explorer",
          "group": "navigation@1"
        },
        {
          "command": "codevault.search",
          "when": "view == codevault-explorer",
          "group": "navigation@2"
        },
        {
          "command": "codevault.refresh",
          "when": "view == codevault-explorer",
          "group": "navigation@3"
        },
        {
          "command": "codevault.export",
          "when": "view == codevault-explorer",
          "group": "overflow@1"
        },
        {
          "command": "codevault.import",
          "when": "view == codevault-explorer",
          "group": "overflow@2"
        }
      ],
      "view/item/context": [
        {
          "command": "codevault.copy",
          "when": "view == codevault-explorer && viewItem =~ /^item/",
          "group": "inline@1"
        },
        {
          "command": "codevault.execute",
          "when": "view == codevault-explorer && viewItem =~ /^item-command/",
          "group": "inline@2"
        },
        {
          "command": "codevault.edit",
          "when": "view == codevault-explorer && viewItem =~ /^item/",
          "group": "1_actions@1"
        },
        {
          "command": "codevault.copy",
          "when": "view == codevault-explorer && viewItem =~ /^item/",
          "group": "1_actions@2"
        },
        {
          "command": "codevault.execute",
          "when": "view == codevault-explorer && viewItem =~ /^item-command/",
          "group": "1_actions@3"
        },
        {
          "command": "codevault.delete",
          "when": "view == codevault-explorer && viewItem =~ /^item/",
          "group": "2_danger@1"
        }
      ]
    },
    "keybindings": [
      {
        "command": "codevault.add",
        "key": "ctrl+alt+v a",
        "mac": "cmd+alt+v a"
      },
      {
        "command": "codevault.search",
        "key": "ctrl+alt+v s",
        "mac": "cmd+alt+v s"
      },
      {
        "command": "codevault.copy",
        "key": "ctrl+alt+v c",
        "mac": "cmd+alt+v c"
      },
      {
        "command": "codevault.execute",
        "key": "ctrl+alt+v e",
        "mac": "cmd+alt+v e"
      }
    ],
    "configuration": {
      "title": "CodeVault",
      "properties": {
        "codevault.defaultTerminal": {
          "type": "string",
          "default": "",
          "description": "Name of the terminal profile to use for executing commands. Leave empty for the default terminal."
        },
        "codevault.confirmBeforeDelete": {
          "type": "boolean",
          "default": true,
          "description": "Show confirmation dialog before deleting items."
        },
        "codevault.showLanguageBadge": {
          "type": "boolean",
          "default": true,
          "description": "Show language badge next to snippet and function items in the tree."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "webpack --mode production",
    "watch": "webpack --mode development --watch",
    "lint": "eslint src --ext ts",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/vscode": "^1.85.0",
    "@types/node": "^20.0.0",
    "typescript": "^5.3.0",
    "ts-loader": "^9.5.0",
    "webpack": "^5.89.0",
    "webpack-cli": "^5.1.0",
    "@vscode/vsce": "^3.0.0"
  }
}